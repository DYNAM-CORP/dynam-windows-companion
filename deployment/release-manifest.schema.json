{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DYNAM Windows Companion public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channel", "version", "releasedAt", "source", "minimumGatewayVersion", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "DYNAM Windows Companion"},
    "channel": {"const": "stable"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "releasedAt": {"type": "string", "format": "date-time"},
    "minimumGatewayVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"const": "DYNAM-CORP/dynam-windows-companion"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["architecture", "installerUrl", "sha256", "signing"],
        "properties": {
          "architecture": {"enum": ["x64", "arm64"]},
          "installerUrl": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "signing": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "publisher", "certificateThumbprint"],
            "properties": {
              "status": {"const": "signed"},
              "publisher": {"type": "string", "minLength": 1},
              "certificateThumbprint": {"type": "string", "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"}
            }
          }
        }
      }
    }
  }
}
